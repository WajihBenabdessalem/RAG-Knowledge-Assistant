# Fournisseur LLM : "openai" ou "anthropic"
LLM_PROVIDER=openai

# Clés API (ne renseigner que celle du provider choisi)
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=

# Modèles
EMBEDDING_MODEL=text-embedding-3-small
LLM_MODEL=gpt-4o-mini

# Stockage vectoriel & documents source
CHROMA_PERSIST_DIR=data/chroma
DOCS_DIR=data/sample_docs

# Découpage des documents
CHUNK_SIZE=800
CHUNK_OVERLAP=120
TOP_K=4

# API
API_HOST=0.0.0.0
API_PORT=8000
